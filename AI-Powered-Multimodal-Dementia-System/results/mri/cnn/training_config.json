{
  "experiment_name": "MRI_Dementia_Classification",
  "dataset_version": "MRI_V1_CLEAN",
  "train_split": "data/mri/metadata/train.csv",
  "validation_split": "data/mri/metadata/validation.csv",
  "test_split": "data/mri/metadata/test.csv",
  "train_count": 8704,
  "validation_count": 1536,
  "test_count": 1279,
  "total_count": 11519,
  "image_size": 224,
  "normalization": {
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "grayscale_handling": "convert to RGB",
  "class_mapping": {
    "Non-Demented": 0,
    "Very Mildly Demented": 1,
    "Mildly Demented": 2,
    "Moderately Demented": 3
  },
  "model": "MRI_CNN",
  "loss": "CrossEntropyLoss",
  "optimizer": "Adam",
  "learning_rate": 0.001,
  "weight_decay": 0,
  "batch_size": 16,
  "max_epochs": 30,
  "early_stopping_patience": 7,
  "dropout": 0.3,
  "seed": 42,
  "device": "cpu",
  "selection_criterion": "lowest validation loss",
  "metric_average": "macro for precision, recall, F1"
}